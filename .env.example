# Copia este archivo como ".env" (sin el ".example") para cambiar estos valores.
# El archivo ".env" nunca se comitea. Vite solo expone al navegador las variables que
# empiezan con VITE_, y todo lo que empieza con VITE_ queda visible en el código público:
# aquí nunca van secretos.

# URL base de la API del backend (incluye /api/v1). Si no se define, se usa esta misma.
VITE_API_URL=http://localhost:8080/api/v1
